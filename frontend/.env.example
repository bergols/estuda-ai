# Copie para .env.local (fora do git): cp .env.example .env.local
# Só o SERVIDOR do Next lê estas variáveis (sem o prefixo NEXT_PUBLIC_, nada vai para
# o navegador). O navegador fala só com o Next; o Next fala com a API.

# Onde a API (FastAPI) está, visto pelo servidor do Next
BACKEND_URL=http://localhost:8000
# O mesmo BFF_SEGREDO do .env da raiz (openssl rand -hex 32)
BFF_SEGREDO=troque-por-64-caracteres-hexadecimais-gerados-com-openssl-rand

# Tamanho máximo de PDF no upload, em MB. Na Vercel o corpo de uma requisição a uma
# função tem no máximo 4,5 MB: use 4. Rodando tudo na VM, pode subir até 20.
# NEXT_PUBLIC_ vai para o navegador (não é segredo; é só o aviso de tamanho).
NEXT_PUBLIC_LIMITE_UPLOAD_MB=4
