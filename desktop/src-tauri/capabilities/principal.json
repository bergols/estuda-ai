{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "principal",
  "description": "O que a janela principal (as telas do frontend, servidas de dentro do app) pode chamar.",
  "windows": ["principal"],
  "permissions": [
    "core:default",
    "allow-chamar-api",
    "allow-entrar",
    "allow-sair",
    "allow-salvar-sessao",
    "allow-sessao-em-andamento",
    "allow-situacao-sincronia",
    "allow-sincronizar-agora",
    "allow-modo-foco",
    "allow-sistema",
    "allow-spotify-conectar",
    "allow-spotify-tocar",
    "allow-spotify-pausar",
    "allow-spotify-retomar",
    "allow-spotify-atual",
    "allow-spotify-proxima",
    "allow-spotify-anterior",
    "allow-spotify-volume",
    "allow-atualizacao-verificar",
    "allow-atualizacao-instalar",
    "allow-foco-sites-bloquear",
    "allow-foco-sites-liberar",
    "allow-foco-sites-restaurar",
    "allow-foco-sites-situacao",
    "allow-foco-programas-iniciar",
    "allow-foco-programas-parar"
