# Caddy no modo "Vercel + VM" (o padrão): o frontend roda na Vercel e esta VM publica
# só a API, em https://{$DOMINIO}.
#
# A API só responde a quem traz o X-BFF-Segredo certo, ou seja, ao BFF na Vercel. Para
# qualquer outro (robôs varrendo a internet, alguém que descobriu o domínio), ela
# simplesmente não existe: 404, inclusive /docs e /auth/login. Defesa em profundidade:
# mesmo sem isso, toda rota exige JWT; com isso, nem a tela de login fica exposta à
# força bruta direta. /health fica aberto para monitoramento.
#
# Modo alternativo (tudo na VM, sem Vercel): Caddyfile.completo + perfil "frontend-na-vm".

{$DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@saude path /health
	handle @saude {
		reverse_proxy backend:8000
	}

	@semSegredo not header X-BFF-Segredo {$BFF_SEGREDO}
	handle @semSegredo {
		respond 404
	}

	handle {
		# A Vercel limita o corpo a 4,5 MB; 25 MB cobre o modo "tudo na VM"
		request_body {
			max_size 25MB
		}
		reverse_proxy backend:8000
	}
}
