# Copie para .env e ajuste: cp .env.example .env
# O .env está no .gitignore — nunca commite senhas ou chaves de API.

# --- Postgres (usado pelo container do banco) ---
POSTGRES_USER=estuda_ai
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=estuda_ai
# Porta exposta no seu Mac (o container sempre usa 5432 por dentro)
POSTGRES_PORT=5432

# --- Backend ---
# Dentro do docker compose o host do banco é "db" (nome do serviço).
# Rodando o backend fora do Docker, troque "db" por "localhost".
DATABASE_URL=postgresql+psycopg://estuda_ai:troque-esta-senha@db:5432/estuda_ai
# Banco separado para os testes (criado automaticamente pelo pytest)
TEST_DATABASE_URL=postgresql+psycopg://estuda_ai:troque-esta-senha@db:5432/estuda_ai_test

# --- Materiais e embeddings (fase 2) ---
# Pasta dos PDFs enviados (no compose é um volume montado em /data/uploads)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20
# Modelo local de embeddings (384 dimensões; precisa bater com vector(384))
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Fases futuras ---
# ANTHROPIC_API_KEY=
