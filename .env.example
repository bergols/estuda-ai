# Copie para .env e ajuste: cp .env.example .env
# Troque TODAS as senhas e o JWT_SECRET; nunca reaproveite entre ambientes.
# O .env está no .gitignore — nunca commite senhas ou chaves de API.

# --- Postgres (usado pelo container do banco) ---
POSTGRES_USER=estuda_ai
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=estuda_ai
# Porta exposta no seu Mac (o container sempre usa 5432 por dentro)
POSTGRES_PORT=5432

# --- Backend ---
# Dentro do docker compose o host do banco é "db" (nome do serviço).
# Rodando o backend fora do Docker, troque "db" por "localhost".
#
# MENOR PRIVILÉGIO (fase 6): a API conecta com o papel estuda_ai_app, que só lê e
# escreve dados. Use uma senha DIFERENTE da do dono; scripts/papel_app.py a aplica.
DATABASE_URL=postgresql+psycopg://estuda_ai_app:troque-esta-outra-senha@db:5432/estuda_ai
# Migrations e scripts de admin: o dono do schema (o POSTGRES_USER acima).
MIGRATION_DATABASE_URL=postgresql+psycopg://estuda_ai:troque-esta-senha@db:5432/estuda_ai
# Os testes criam e usam o banco <nome>_test, com os mesmos dois papéis.

# --- Materiais e embeddings (fase 2) ---
# Pasta dos PDFs enviados (no compose é um volume montado em /data/uploads)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20
# Modelo local de embeddings (384 dimensões; precisa bater com vector(384))
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Autenticação (fase 6) ---
# Segredo que assina os tokens de login (JWT). Quem tiver este valor consegue se
# passar por qualquer usuário: gere um aleatório por ambiente e nunca o reaproveite.
#   openssl rand -hex 32
JWT_SECRET=troque-por-64-caracteres-hexadecimais-gerados-com-openssl-rand
# Por quantos dias o login vale (o "sair de todos" revoga antes disso)
JWT_DIAS=30

# --- Proteção de custo e contra força bruta (fase 6) ---
# Gerações com IA por dia (fuso do usuário), contadas na auditoria; 0 = IA desligada
LIMITE_GERACOES_DIA=50
# Rate limiting (janelas fixas, contadas no Postgres)
LIMITE_IA_POR_MINUTO=10
LIMITE_LOGIN_POR_IP=20
LIMITE_LOGIN_POR_EMAIL=5

# --- Frontend (BFF) ---
# Segredo compartilhado com o servidor do Next.js: só com ele a API aceita o IP do
# cliente que o Next repassa (X-Cliente-IP). Use o MESMO valor em frontend/.env.local.
#   openssl rand -hex 32
BFF_SEGREDO=troque-por-64-caracteres-hexadecimais-gerados-com-openssl-rand

# --- Spotify (fase 7) ---
# Client ID do app criado em developer.spotify.com/dashboard (público no fluxo PKCE;
# NÃO existe client secret neste fluxo, nunca o coloque aqui).
# SPOTIFY_CLIENT_ID=
# Chaves que cifram os tokens do Spotify no banco: "versão:base64(32 bytes)", a 1a é a
# atual. Para trocar de chave: "2:<nova>,1:<antiga>" e os tokens são recifrados no uso.
#   echo "1:$(openssl rand -base64 32)"
CIFRA_CHAVES=1:troque-por-32-bytes-em-base64-gerados-com-openssl-rand-base64

# --- LLM (fase 3) ---
# Chave da API da Anthropic (console.anthropic.com). Descomente e preencha só no
# seu .env, que está no .gitignore. NUNCA coloque uma chave real neste arquivo.
# Deixe a linha comentada se não tiver chave: uma variável vazia também conta
# como "chave definida" para o SDK e gera erro de autenticação.
# ANTHROPIC_API_KEY=sk-ant-...
# Modelo usado nas gerações (o Haiku é o mais barato: US$ 1 / 5 por milhão de tokens)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
